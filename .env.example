# Payload
PAYLOAD_SECRET=CHANGE-ME-generate-a-random-32-char-string
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Database (Neon Postgres)
DATABASE_URI=postgres://user:password@host.neon.tech/wfmlabshub?sslmode=require

# Storage (Cloudflare R2 — S3-compatible)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=wfmlabshub-media
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@community.wfmlabs.com

